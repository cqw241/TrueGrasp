# 复制为 backend/.env 后填写。不要提交 .env。

# 模型接入（OpenAI 兼容接口）
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# DeepSeek: JSON mode plus local schema validation; other providers may use json_schema.
LLM_RESPONSE_FORMAT=json_object
LLM_TIMEOUT=60
LLM_VALIDATION_RETRIES=2
LLM_MAX_TOOL_ROUNDS=8

# 拍照作答需要支持图片输入的 OpenAI 兼容模型。未设置时沿用 LLM_*。
# 若指定独立地址，需同时填写独立密钥和模型。
VISION_LLM_BASE_URL=
VISION_LLM_API_KEY=
VISION_LLM_MODEL=

# 业务数据库（SQLModel）与 LangGraph checkpoint，路径相对 backend/
DATABASE_URL=sqlite:///./data/truegrasp.db
CHECKPOINT_DB_PATH=./data/checkpoints.db

# 教学时钟：demo 为持久化的演示日期；real 跟随 Asia/Shanghai 的真实日期。
# 初始日期仅在 demo 模式首次初始化数据库时使用。
TEACHING_CLOCK_MODE=demo
TEACHING_CLOCK_INITIAL_DATE=2026-09-07
