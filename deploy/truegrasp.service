[Unit]
Description=TrueGrasp teaching application
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=truegrasp
Group=truegrasp
WorkingDirectory=/opt/truegrasp/current/backend
EnvironmentFile=/etc/truegrasp/runtime.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/truegrasp/current/backend/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 18001 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1 --timeout-graceful-shutdown 30
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
StateDirectory=truegrasp
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
